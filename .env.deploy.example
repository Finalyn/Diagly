# Accès au serveur de production. Copier en .env.deploy et remplir.
# .env.deploy n'est pas versionné : il ne doit jamais partir sur GitHub.

# Hôte SSH du serveur Infomaniak, et l'utilisateur qui porte l'application.
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22

# Dossier de l'application sur le serveur. Il doit contenir web/ (le front,
# vers lequel pointe STATIC_DIR) et server/ (l'API compilée et son .env).
DEPLOY_PATH=/home/clients/xxxx/sites/diagly

# Comment relancer l'API après transfert : pm2:<nom> ou systemd:<unité>.
DEPLOY_SERVICE=pm2:diagly
