# URL du backend Diagly (server/)
# En dev : laisser la valeur par défaut
VITE_API_URL=http://localhost:4000

# Clé des fonds de carte CARTO (gratuite, sans compte : https://carto.com/basemaps/apikey/)
# Sans elle, les tuiles portent un filigrane « API KEY REQUIRED ».
# Doit aussi être présente au moment du BUILD de production, la valeur finit dans le bundle
# (c'est une clé publique : restreignez-la au domaine diagly.ch dans le formulaire CARTO).
VITE_CARTO_KEY=
