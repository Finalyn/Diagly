# ---------------------------------------------------------------- obligatoire

# Connexion à la base. La valeur ci-dessous correspond au MySQL lancé par
# `npm run db:up` (docker-compose.yml). Adaptez-la si votre MySQL est ailleurs.
DATABASE_URL="mysql://diagly:diagly_dev@localhost:3306/diagly"

# Deux secrets distincts, 32 caractères minimum chacun. Le serveur refuse de
# démarrer en dessous. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# ------------------------------------------------------------------- serveur

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# URL publique de l'application. En développement, laissez localhost.
# En production, mettez le vrai domaine : sans lui, la connexion Google, le lien
# de réinitialisation du mot de passe et les invitations d'équipe pointent dans
# le vide. Le serveur le signale au démarrage.
APP_URL=http://localhost:4000

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- facultatif
# Tout ce qui suit peut rester vide : l'application fonctionne sans, la
# fonction concernée se désactive proprement.

# Assistant IA : état proposé depuis la photo, analyse, import d'un CECB en PDF.
# Sans clé, l'assistant répond qu'il est indisponible.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Envoi des emails (invitations d'équipe, mot de passe oublié, tickets).
# Sans SMTP, le lien est affiché à l'écran au lieu d'être envoyé.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Diagly <noreply@diagly.ch>"
SUPPORT_EMAIL=contact@finalyn.com

# Connexion Google. Sans ces deux valeurs, le bouton n'apparaît pas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notifications push. Sans les clés VAPID, le push est désactivé.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@diagly.ch

# Poivre pour le hachage des clés d'API. À défaut, JWT_ACCESS_SECRET est utilisé.
API_KEY_PEPPER=
