# Connexion DB locale (docker-compose ci-dessous lance MySQL sur 3306)
DATABASE_URL="mysql://diagly:diagly_dev@localhost:3306/diagly"

# Serveur
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT — IMPORTANT : changer en prod et garder secret
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Bcrypt
BCRYPT_ROUNDS=12
