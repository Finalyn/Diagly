# ---------------------------------------------------------------- obligatoire

# Connexion à la base. La valeur ci-dessous correspond au MySQL lancé par
# `npm run db:up` (docker-compose.yml). Adaptez-la si votre MySQL est ailleurs.
DATABASE_URL="mysql://diagly:diagly_dev@localhost:3306/diagly"

# Deux secrets distincts, 32 caractères minimum chacun. Le serveur refuse de
# démarrer en dessous. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# ------------------------------------------------------------------- serveur

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# URL publique de l'application. En développement, laissez localhost.
# En production, mettez le vrai domaine : sans lui, la connexion Google, le lien
# de réinitialisation du mot de passe et les invitations d'équipe pointent dans
# le vide. Le serveur le signale au démarrage.
APP_URL=http://localhost:4000

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- facultatif
# Tout ce qui suit peut rester vide : l'application fonctionne sans, la
# fonction concernée se désactive proprement.

# Assistant IA : état proposé depuis la photo, analyse, import d'un CECB en PDF.
# Sans clé, l'assistant répond qu'il est indisponible.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Envoi des emails (invitations d'équipe, mot de passe oublié, tickets).
# Sans SMTP, le lien est affiché à l'écran au lieu d'être envoyé.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Diagly <noreply@diagly.ch>"
SUPPORT_EMAIL=contact@finalyn.com

# Connexion Google. Sans ces deux valeurs, le bouton n'apparaît pas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notifications push. Sans les clés VAPID, le push est désactivé.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@diagly.ch

# Poivre pour le hachage des clés d'API. À défaut, JWT_ACCESS_SECRET est utilisé.
API_KEY_PEPPER=

# Comptes administrateurs de Finalyn (e-mails séparés par des virgules).
FINALYN_ADMINS=contact@finalyn.com

# Mot de passe du compte admin créé au tout premier déploiement (base vide),
# 12 caractères au moins. Sans lui, un mot de passe provisoire est tiré au
# hasard et affiché une fois dans la console (prisma/seed.ts).
SEED_ADMIN_PASSWORD=

# Dossier du front construit (dist), servi par le serveur en production.
STATIC_DIR=

# App iPhone/iPad : clé Apple (APNs et « Se connecter avec Apple »).
# APPLE_PRIVATE_KEY est le contenu du fichier .p8, sur une ligne, \n compris.
APPLE_BUNDLE_ID=ch.diagly.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# « Se connecter avec Apple » sur le site (l'app iPhone/iPad n'en a pas besoin).
# L'identifiant de service (Services ID) créé chez Apple, par ex. ch.diagly.web,
# rattaché à l'App ID ch.diagly.app. Adresse de retour à y déclarer : APP_URL
# suivie de /api/auth/apple/web/retour (https obligatoire). Sans lui, le bouton
# Apple n'apparaît pas sur le site. La clé ci-dessus sert aussi à garder de quoi
# révoquer l'accès à la suppression du compte ; sans elle, la connexion marche.
APPLE_SERVICES_ID=
# true pour envoyer aux apps installées depuis Xcode (environnement de test).
APNS_SANDBOX=false

# Indice des prix de la construction (lib/market.ts). À renseigner le jour où
# une nouvelle valeur est publiée ; sans elles, les prix restent à la base.
DIAGLY_BASE_INDEX=
DIAGLY_MARKET_INDEX=
DIAGLY_MARKET_INDEX_DATE=
DIAGLY_MARKET_INDEX_SOURCE=
DIAGLY_LEGACY_COST_INDEX=
