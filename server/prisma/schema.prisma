// Diagly — schéma Prisma
// SGBD cible : MySQL 8.x (utf8mb4)
// Tables :
//   - users / refresh_tokens           : auth
//   - projects                          : Diagnostic projet (un bâtiment évalué)
//   - diagnostics                       : visite d'un projet à un instant T
//   - diagnostic_items                  : observation CFC sur un diagnostic
//   - cfc_catalog (seed, read-only)     : nomenclature CFC suisse
//   - catalog_items (seed, read-only)   : catalogue opérationnel avec prix

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

enum UserRole {
  DT
  REGIE
  ARCHITECT
  PARTICULIER
  ADMIN
}

/// Rôle au sein d'une organisation (distinct du rôle produit UserRole). VIEWER = lecture seule.
enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  firstName         String?   @map("first_name") @db.VarChar(100)
  lastName          String?   @map("last_name") @db.VarChar(100)
  role              UserRole  @default(PARTICULIER)
  companyName       String?   @map("company_name") @db.VarChar(150)
  phone             String?   @db.VarChar(50)
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret   String?   @map("two_factor_secret") @db.VarChar(255)
  /// Méthode de la double authentification : TOTP (application) ou EMAIL (code envoyé).
  /// null sur un compte activé avant l'email : il a un secret, c'est donc l'application.
  twoFactorMethod   String?   @map("two_factor_method") @db.VarChar(10)
  /// « Se connecter avec Apple » : l'identifiant stable de la personne pour l'app.
  /// Unique en pratique (la connexion le cherche avant d'en poser un), mais sans
  /// contrainte UNIQUE : l'ajouter fait poser une question à prisma db push, et
  /// le build d'Infomaniak, qui ne peut pas y répondre, échoue.
  appleSub          String?   @map("apple_sub") @db.VarChar(100)
  /// Jeton de rafraîchissement Apple, gardé pour révoquer l'accès quand le compte
  /// est supprimé (exigence d'Apple). null sans connexion Apple.
  appleRefreshToken String?   @map("apple_refresh_token") @db.VarChar(512)
  /// Appartenance à une organisation (partage du parc entre membres). null = compte solo.
  organizationId    String?   @map("organization_id")
  orgRole           OrgRole?  @map("org_role")
  /// Préférences (entreprise, défauts métier, notifications, apparence…) en JSON.
  preferences       Json      @default("{}")
  /// Dernière visite sur Diagly (requireAuth, au plus une écriture par heure) :
  /// d'où se comptent les rappels d'absence. null = pas encore suivie.
  vuLe              DateTime? @map("vu_le")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  projects          Project[]
  operations        Operation[]
  refreshTokens     RefreshToken[]
  events            Event[]
  pushSubscriptions PushSubscription[]
  appareilsPush     AppareilPush[]
  notifications     Notification[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  supportTickets    SupportTicket[]
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([appleSub])
  @@map("users")
}

enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// Demande de support (ticket) créée depuis le centre d'aide. Le fil de discussion vit dans SupportMessage.
model SupportTicket {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  email     String        @db.VarChar(255)
  subject   String        @db.VarChar(200)
  category  String?       @db.VarChar(50)
  status    SupportStatus @default(OPEN)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@map("support_tickets")
}

/// Message d'un fil de support (client ou support), avec pièces jointes (captures d'écran).
model SupportMessage {
  id          String   @id @default(cuid())
  ticketId    String   @map("ticket_id")
  authorName  String   @map("author_name") @db.VarChar(150)
  isSupport   Boolean  @default(false) @map("is_support")
  body        String   @db.Text
  /// URLs des pièces jointes (images) sérialisées en JSON.
  attachments Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("support_messages")
}

/// Organisation = tenant regroupant plusieurs membres qui partagent le même parc de diagnostics.
model Organization {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(80)
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members     User[]
  invitations OrgInvitation[]

  @@map("organizations")
}

/// Invitation à rejoindre une organisation (par email + lien à jeton).
model OrgInvitation {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  email          String    @db.VarChar(255)
  role           OrgRole   @default(MEMBER)
  token          String    @unique @db.VarChar(80)
  invitedById    String    @map("invited_by_id")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("org_invitations")
}

/// Clé d'API (par compte/organisation) pour l'API REST publique v1. Le secret n'est
/// jamais stocké : seul son hash sha256 l'est. `keyPrefix` sert à l'affichage/identification.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String    @db.VarChar(120)
  keyPrefix  String    @map("key_prefix") @db.VarChar(30)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  scopes     Json      @default("[\"read\"]")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

/// Endpoint webhook (par compte/organisation) : URL notifiée en temps réel des événements Diagly.
model WebhookEndpoint {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  url         String   @db.VarChar(500)
  /// Secret partagé pour la signature HMAC-SHA256 du payload (whsec_...).
  secret      String   @db.VarChar(255)
  /// Types d'événements abonnés (JSON string[]) : diagnostic.finalise, rapport.genere, element.modifie, plan_travaux.mis_a_jour.
  events      Json     @default("[]")
  active      Boolean  @default(true)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
  @@map("webhook_endpoints")
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
}

/// Tentative de livraison d'un événement à un endpoint (file + journal + rejeu).
model WebhookDelivery {
  id             String        @id @default(cuid())
  endpointId     String        @map("endpoint_id")
  userId         String        @map("user_id")
  eventType      String        @map("event_type") @db.VarChar(50)
  payload        Json
  /// Clé de coalescing (ex. "element.modifie:diagnostic:<id>") pour absorber les rafales.
  coalesceKey    String?       @map("coalesce_key") @db.VarChar(120)
  status         WebhookStatus @default(PENDING)
  attempts       Int           @default(0)
  nextAttemptAt  DateTime      @map("next_attempt_at")
  responseStatus Int?          @map("response_status")
  error          String?       @db.VarChar(500)
  deliveredAt    DateTime?     @map("delivered_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId])
  @@index([userId])
  @@map("webhook_deliveries")
}

/// Journal d'accès à l'API publique (auditable — attendu en appel d'offres institutionnel).
model ApiAccessLog {
  id         String   @id @default(cuid())
  apiKeyId   String?  @map("api_key_id")
  userId     String   @map("user_id")
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(400)
  status     Int
  ip         String?  @db.VarChar(64)
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([apiKeyId])
  @@index([userId])
  @@index([createdAt])
  @@map("api_access_logs")
}

/// Un iPhone ou un iPad qui reçoit les notifications de l'app (APNs). Le jeton
/// change rarement, mais il change : l'app le renvoie à chaque démarrage.
model AppareilPush {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  jeton      String   @unique @db.VarChar(200)
  plateforme String   @default("ios") @db.VarChar(10)
  creeLe     DateTime @default(now()) @map("cree_le")
  vuLe       DateTime @default(now()) @map("vu_le")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("appareils_push")
}

/// Abonnement Web Push (un par appareil/navigateur).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- Domaine métier ----------

enum BuildingType {
  LOGEMENT
  VILLA
  CHALET
  SCOLAIRE
  BUREAU
  ADMINISTRATIF
  INDUSTRIEL
  HOTEL
  COMMERCIAL
  AUTRE
}

enum ProjectStatus {
  NON_PLANIFIE
  PLANIFIE
  EN_COURS
  EN_REVUE
  TERMINE
  ARCHIVE
}

/// Mode d'agrégation des coûts/rapports d'une opération multi-bâtiments.
enum AggregationMode {
  TOTAL // tout cumulé sur l'opération
  PER_BUILDING // chaque bâtiment séparément
}

/// Opération / parc : regroupe plusieurs bâtiments (Project) d'un même chantier.
model Operation {
  id              String          @id @default(cuid())
  ownerId         String          @map("owner_id")
  name            String          @db.VarChar(255)
  clientName      String?         @map("client_name") @db.VarChar(150)
  aggregationMode AggregationMode @default(PER_BUILDING) @map("aggregation_mode")
  status          ProjectStatus   @default(NON_PLANIFIE)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([ownerId])
  @@map("operations")
}

model Project {
  id                    String        @id @default(cuid())
  ownerId               String        @map("owner_id")
  operationId           String?       @map("operation_id")
  name                  String        @db.VarChar(255)
  address               String        @db.VarChar(255)
  postalCode            String?       @map("postal_code") @db.VarChar(10)
  city                  String        @db.VarChar(150)
  canton                String        @db.VarChar(50)
  parcelNumber          String?       @map("parcel_number") @db.VarChar(50)
  buildingType          BuildingType  @map("building_type")
  roofType              String?       @map("roof_type") @db.VarChar(20)
  yearBuilt             Int?          @map("year_built")
  renovationYear        Int?          @map("renovation_year")
  nbApartments          Int?          @map("nb_apartments")
  /// Nombre de logements deja renoves : ils appellent moins de travaux.
  renovatedApartments   Int?          @map("renovated_apartments")
  /// Repartition par typologie, ex. { "2.5": 4, "3.5": 6 }. Sert au comptage des pieces d'eau.
  apartmentTypes        Json?         @map("apartment_types")
  nbFloors              Int?          @map("nb_floors")
  floorHeight           Float?        @map("floor_height")
  nbStaircases          Int?          @map("nb_staircases")
  floorArea             Float?        @map("floor_area")
  builtArea             Float?        @map("built_area")
  facadeArea            Float?        @map("facade_area")
  terrainArea           Float?        @map("terrain_area")
  perimeter             Float?
  windowPct             Float         @default(30) @map("window_pct")
  honoraryPct           Float         @default(12) @map("honorary_pct")
  reservePct            Float         @default(10) @map("reserve_pct")
  status                ProjectStatus @default(NON_PLANIFIE)
  totalBudget           Decimal?      @map("total_budget") @db.Decimal(14, 2)
  /// --- Données énergétiques importées d'un certificat (lecture, pas émission) ---
  sre                   Float?        @map("sre")
  energyConsumptionHeat Float?        @map("energy_consumption_heat")
  energyConsumptionElec Float?        @map("energy_consumption_elec")
  energyAgent           String?       @map("energy_agent") @db.VarChar(120)
  energyClassEnvelope   String?       @map("energy_class_envelope") @db.VarChar(1)
  energyClassGlobal     String?       @map("energy_class_global") @db.VarChar(1)
  energyRefYear         Int?          @map("energy_ref_year")
  energySource          String?       @map("energy_source") @db.VarChar(60)
  energyCertDate        DateTime?     @map("energy_cert_date")
  energyData            Json?         @map("energy_data")
  /// --- Enrichissement géographique (geo.admin, lecture) ---
  east                  Float?        @map("east")
  north                 Float?        @map("north")
  egid                  String?       @map("egid") @db.VarChar(20)
  egrid                 String?       @map("egrid") @db.VarChar(30)
  geoSource             String?       @map("geo_source") @db.VarChar(60)
  geoFetchedAt          DateTime?     @map("geo_fetched_at")
  geoData               Json?         @map("geo_data")
  /// Partage client en lecture seule : jeton public (null = non partagé).
  shareToken            String?       @unique @map("share_token") @db.VarChar(64)
  /// Apparence propre a ce dossier : logo, couleur, raison sociale, auteur.
  /// null = celle des preferences de l'utilisateur. Un rapport se personnalise
  /// pour un client sans changer les reglages de tous les autres.
  reportBranding        Json?         @map("report_branding")
  sharedAt              DateTime?     @map("shared_at")
  /// Organisation de la visite : rendez-vous, créneaux proposés, préparation.
  /// Le rendez-vous est recopié dans un Event (calendrier) et dans visitDate.
  visitPlan             Json?         @map("visit_plan")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  operation   Operation?       @relation(fields: [operationId], references: [id], onDelete: SetNull)
  diagnostics Diagnostic[]
  plans       Plan[]
  planBoards  PlanBoard[]
  events      Event[]
  variants    ProjectVariant[]
  contacts    ProjectContact[]
  mails       ProjectMail[]

  @@index([ownerId])
  @@index([operationId])
  @@index([status])
  @@map("projects")
}

/// Interlocuteur d'un dossier pour la visite : gérance, propriétaire, concierge,
/// locataire… Le rôle est libre côté base (GERANCE, PROPRIETAIRE, CONCIERGE,
/// LOCATAIRE, ENTREPRISE, AUTRE) pour en ajouter sans migration.
model ProjectContact {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  role      String   @db.VarChar(30)
  name      String   @db.VarChar(150)
  company   String?  @db.VarChar(150)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(40)
  /// Logement ou étage, pour un locataire.
  unit      String?  @db.VarChar(80)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_contacts")
}

/// Mail préparé depuis l'organisation de la visite, tel qu'il est parti.
/// status : ENVOYE (par le serveur), ECHEC, MESSAGERIE (ouvert dans le
/// logiciel de messagerie de l'utilisateur, envoi non vérifiable).
model ProjectMail {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  userId     String   @map("user_id")
  authorName String   @map("author_name") @db.VarChar(150)
  template   String   @db.VarChar(40)
  subject    String   @db.VarChar(255)
  body       String   @db.Text
  /// [{ name, email }]
  recipients Json
  status     String   @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_mails")
}

/// Professionnel de l'annuaire Partenaires (architecte, expert CECB®, ingénieur…).
/// Tenu par Finalyn : seuls ses administrateurs créent, modifient et publient.
model Partner {
  id            String   @id @default(cuid())
  /// PRO : un professionnel qu'on contacte par Diagly. OUTIL : un service en
  /// ligne qu'on rejoint par un lien, souvent avec une offre (ex. Arkia).
  type          String   @default("PRO") @db.VarChar(10)
  nom           String   @db.VarChar(150)
  /// Personne de contact au sein du bureau.
  contact       String?  @db.VarChar(150)
  /// Métiers (codes : ARCHITECTE, EXPERT_CECB, INGENIEUR_CIVIL…).
  metiers       Json
  /// Cantons couverts (VD, GE, FR…).
  cantons       Json
  /// Langues de travail (fr, de, it, en).
  langues       Json
  description   String?  @db.Text
  /// Ce que fait un outil, en quelques mots (« Images par IA »).
  categorie     String?  @db.VarChar(100)
  /// L'offre réservée aux utilisateurs de Diagly, et le lien qui la donne.
  offre         String?  @db.VarChar(255)
  lienOffre     String?  @map("lien_offre") @db.VarChar(500)
  /// Nombre de fois où le lien de l'offre a été ouvert depuis Diagly.
  clics         Int      @default(0)
  /// Obligatoire pour un professionnel : les demandes y arrivent.
  email         String?  @db.VarChar(255)
  telephone     String?  @db.VarChar(40)
  siteWeb       String?  @map("site_web") @db.VarChar(255)
  localite      String?  @db.VarChar(150)
  /// Certification vérifiée par Finalyn (ex. expert CECB® sur la liste officielle).
  verifie       Boolean  @default(false)
  /// Ce que Finalyn a vérifié, montré tel quel (« Expert CECB® certifié »).
  certification String?  @db.VarChar(255)
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  demandes PartnerRequest[]

  @@map("partners")
}

/// Demande de mise en relation envoyée par un utilisateur à un partenaire.
/// statut : ENVOYEE, MESSAGERIE (ouverte dans la messagerie), ECHEC, EN_COURS, TERMINEE.
model PartnerRequest {
  id          String   @id @default(cuid())
  partnerId   String   @map("partner_id")
  userId      String   @map("user_id")
  projectId   String?  @map("project_id")
  objet       String   @db.VarChar(255)
  message     String   @db.Text
  /// Résumé du dossier joint, tel qu'il est parti.
  dossier     String?  @db.Text
  lienRapport String?  @map("lien_rapport") @db.VarChar(255)
  statut      String   @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([partnerId])
  @@map("partner_requests")
}

/// Plan (PDF ou image) d'un bâtiment, stocké sur le disque serveur.
model Plan {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  name        String   @db.VarChar(255)
  fileName    String   @map("file_name") @db.VarChar(255)
  mimeType    String   @map("mime_type") @db.VarChar(100)
  size        Int      @db.UnsignedInt
  /// Échelle : pixels (du rendu) par mètre réel. null si pas encore étalonné.
  scalePxPerM Float?   @map("scale_px_per_m")
  /// Annotations (cotes, notes, hachures…) sérialisées en JSON.
  annotations Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("plans")
}

/// Atelier multi-plans : compose plusieurs plans sur un grand canvas (calques positionnés,
/// teinte/opacité de référence, annotations libres). Toute la composition est en JSON.
model PlanBoard {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String   @default("Atelier") @db.VarChar(150)
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("plan_boards")
}

enum EventCategory {
  VISITE
  REUNION
  TRAVAUX
  ECHEANCE
  APPEL
  AUTRE
}

/// Événement du calendrier (visite, réunion, échéance…), rattaché à l'utilisateur et
/// éventuellement à un projet/bâtiment.
model Event {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  projectId      String?       @map("project_id")
  title          String        @db.VarChar(255)
  category       EventCategory @default(AUTRE)
  color          String?       @db.VarChar(20)
  location       String?       @db.VarChar(255)
  notes          String?       @db.Text
  allDay         Boolean       @default(false) @map("all_day")
  startAt        DateTime      @map("start_at")
  endAt          DateTime?     @map("end_at")
  /// Horodatage d'envoi du rappel push (null = pas encore envoyé).
  reminderSentAt DateTime?     @map("reminder_sent_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@map("events")
}

enum DiagnosticStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

model Diagnostic {
  id        String           @id @default(cuid())
  projectId String           @map("project_id")
  visitDate DateTime?        @map("visit_date")
  status    DiagnosticStatus @default(DRAFT)
  notes     String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   DiagnosticItem[]

  @@index([projectId])
  @@map("diagnostics")
}

enum ElementState {
  TRES_BON
  BON
  MOYEN
  MAUVAIS
}

enum Priority {
  I
  II
  III
}

/// Observation faite sur un Diagnostic : un CFC + un état + des photos/notes + un coût estimé.
/// Où un ouvrage intérieur a été relevé. La note générale du classeur (Feuil2, l. 90)
/// veut que les mêmes articles se relèvent séparément dans les communs et dans les
/// logements : la peinture de la cage et celle des appartements ne vieillissent pas
/// ensemble, et un relevé unique obligeait à en sacrifier une.
/// null = ouvrage qui n'est ni l'un ni l'autre (façade, toiture, locaux techniques, abords).
enum Localisation {
  COMMUNS
  LOGEMENTS
}

model DiagnosticItem {
  id               String        @id @default(cuid())
  diagnosticId     String        @map("diagnostic_id")
  /// Lien logique vers cfc_catalog.code (pas de FK car cfc_catalog est seed-only)
  cfcCode          String        @map("cfc_code") @db.VarChar(10)
  cfcLabel         String        @map("cfc_label") @db.VarChar(255)
  /// Optionnel : id du catalog_items utilisé comme template.
  /// Conservé pour les relevés dont l'ancien article n'a pas de repreneur dans
  /// la base v3 : ils continuent de s'afficher plutôt que de disparaître.
  catalogItemId    Int?          @map("catalog_item_id")
  /// Article de la base v3. Avec l'étape, il identifie le relevé : un même
  /// article relevé dans deux étapes fait deux relevés indépendants.
  articleId        String?       @map("article_id") @db.VarChar(8)
  etapeNumero      Int?          @map("etape_numero") @db.UnsignedTinyInt
  /// Communs / logements pour les articles du chapitre « INTÉRIEUR : » du classeur.
  /// null pour tous les autres, qui ne se relèvent qu'une fois.
  localisation     Localisation?
  /// null = élément ajouté mais pas encore évalué (pas d'état imposé par défaut).
  state            ElementState?
  priority         Priority?
  notes            String?       @db.Text
  /// Liste de travaux retenus, sérialisée en JSON
  works            Json          @default("[]")
  /// Liste d'URL/clefs de photos, sérialisée en JSON
  photos           Json          @default("[]")
  area             Float?
  /// Part de la surface du groupe qui revient a ce type, en pourcent.
  /// null = pas encore repartie, ou ouvrage qui n'appartient a aucun groupe.
  sharePct         Float?        @map("share_pct")
  /// true = quantite saisie par le diagnostiqueur : elle ne doit plus etre recalculee.
  quantityManual   Boolean       @default(false) @map("quantity_manual")
  /// true = cout force a la main : il ne doit plus etre recalcule depuis le catalogue.
  costManual       Boolean       @default(false) @map("cost_manual")
  /// Coefficient marche applique aux couts de cette ligne, au moment ou ils ont
  /// ete ecrits. Permet de les reindexer plus tard sans les ressaisir.
  /// null = ecrit avant l'existence de la colonne (voir LEGACY_COST_INDEX).
  costIndex        Float?        @map("cost_index")
  unit             String?       @db.VarChar(50)
  yearInstalled    Int?          @map("year_installed")
  /// Année d'intervention planifiée (plan de travaux). null = déduite de la priorité à l'export.
  interventionYear Int?          @map("intervention_year")
  estimatedCost    Decimal?      @map("estimated_cost") @db.Decimal(12, 2)
  /// Amélioration retenue (null = non retenue) + son coût. Enveloppe distincte de la réparation.
  improvement      String?       @db.Text
  improvementCost  Decimal?      @map("improvement_cost") @db.Decimal(12, 2)
  /// Remise aux normes retenue (null = non retenue) + son coût. Enveloppe distincte.
  norms            String?       @db.Text
  normsCost        Decimal?      @map("norms_cost") @db.Decimal(12, 2)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  diagnostic   Diagnostic    @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  article      Article?      @relation(fields: [articleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  etape        EtapeVisite?  @relation(fields: [etapeNumero], references: [numero], onDelete: SetNull, onUpdate: Cascade)
  /// Lignes de variante qui se substituent a cet ouvrage.
  variantLines VariantLine[]

  @@index([diagnosticId])
  @@index([cfcCode])
  @@index([articleId], map: "idx_di_article")
  @@map("diagnostic_items")
}

// ---------- Données de référence (peuplées par seed_data.sql) ----------

/// Catalogue CFC suisse hiérarchique (Feuil1 du xlsx). Read-only depuis l'app.
model CfcCatalogEntry {
  code         String  @id @db.VarChar(10)
  label        String  @db.VarChar(255)
  level        Int     @db.UnsignedTinyInt
  parentCode   String? @map("parent_code") @db.VarChar(10)
  stateTbe     String? @map("state_tbe") @db.Text
  stateBon     String? @map("state_bon") @db.Text
  stateMoyen   String? @map("state_moyen") @db.Text
  stateMauvais String? @map("state_mauvais") @db.Text
  improvement  String? @db.Text
  normsUpgrade String? @map("norms_upgrade") @db.Text

  @@index([parentCode], map: "idx_cfc_parent")
  @@index([level], map: "idx_cfc_level")
  @@map("cfc_catalog")
}

/// Catalogue opérationnel (Feuil2 du xlsx) — items diagnostiquables avec prix par état.
/// Prix stockés en VARCHAR car le xlsx mélange nombres et formules ("120*50% des m2").
model CatalogItem {
  id               Int     @id @default(autoincrement()) @db.UnsignedInt
  /// null = item par defaut (reference commune). Sinon = personnalisation d'un utilisateur.
  ownerId          String? @map("owner_id")
  /// Pour une personnalisation : l'id de l'item par defaut qu'elle remplace (null si item cree de zero).
  baseId           Int?    @map("base_id") @db.UnsignedInt
  displayOrder     Int     @map("display_order") @db.UnsignedInt
  /// Groupe de surface : les types alternatifs d'une meme surface le partagent
  /// (revetement de facade, de sol, de paroi). null = ouvrage non alternatif,
  /// qui prend sa quantite entiere. Voir src/lib/groupes-surface.ts.
  surfaceGroup     String? @map("surface_group") @db.VarChar(100)
  category         String? @db.VarChar(150)
  categoryCfc      String? @map("category_cfc") @db.VarChar(10)
  description      String  @db.VarChar(255)
  cfcCode          String? @map("cfc_code") @db.VarChar(10)
  workTbe          String? @map("work_tbe") @db.Text
  workBon          String? @map("work_bon") @db.Text
  workMoyen        String? @map("work_moyen") @db.Text
  workMauvais      String? @map("work_mauvais") @db.Text
  workImprovement  String? @map("work_improvement") @db.Text
  workNorms        String? @map("work_norms") @db.Text
  /// Descriptions d'état (Feuille 3) : ce à quoi ressemble chaque état pour cet élément (aide au diagnostic).
  descTbe          String? @map("desc_tbe") @db.Text
  descBon          String? @map("desc_bon") @db.Text
  descMoyen        String? @map("desc_moyen") @db.Text
  descMauvais      String? @map("desc_mauvais") @db.Text
  unit             String? @db.VarChar(100)
  quantityFormula  String? @map("quantity_formula") @db.VarChar(255)
  priceTbe         String? @map("price_tbe") @db.VarChar(100)
  priceBon         String? @map("price_bon") @db.VarChar(100)
  priceMoyen       String? @map("price_moyen") @db.VarChar(100)
  priceMauvais     String? @map("price_mauvais") @db.VarChar(100)
  priceImprovement String? @map("price_improvement") @db.VarChar(100)
  priceNorms       String? @map("price_norms") @db.VarChar(100)
  scaffoldingNote  String? @map("scaffolding_note") @db.VarChar(255)

  @@unique([ownerId, baseId], map: "uq_ci_owner_base")
  @@index([cfcCode], map: "idx_ci_cfc")
  @@index([category], map: "idx_ci_category")
  @@index([ownerId], map: "idx_ci_owner")
  @@map("catalog_items")
}

/// ---------------------------------------------------------------------------
/// Variantes de projet
///
/// Le diagnostic de base dit ce qu'il faut faire. La variante repond a une autre
/// question : « et si on isolait par l'interieur plutot que par l'exterieur ? »,
/// « et si on passait au pellet, ou au chauffage a distance ? ». Elle ne duplique
/// donc pas le diagnostic : elle ne porte que les arbitrages qui changent, et le
/// reste du dossier vaut par defaut.
///
/// Trois variantes au maximum par projet : au-dela, ce n'est plus un arbitrage
/// mais un catalogue, et la comparaison ne se lit plus.
/// ---------------------------------------------------------------------------
model ProjectVariant {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  name         String   @db.VarChar(120)
  description  String?  @db.Text
  /// Ordre d'affichage et de comparaison, 0 = la premiere proposee.
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines   VariantLine[]

  @@index([projectId])
  @@map("project_variants")
}

/// Un arbitrage de la variante.
///
/// `replacesItemId` porte tout le sens : renseigne, la ligne se substitue a un
/// ouvrage du diagnostic (son montant sort du total et celui-ci le remplace) ;
/// vide, c'est un travail qui n'existait pas dans le diagnostic de base.
/// Un montant a zero sur un remplacement vaut renoncement a l'ouvrage.
model VariantLine {
  id             String        @id @default(cuid())
  variantId      String        @map("variant_id")
  replacesItemId String?       @map("replaces_item_id")
  /// Article du catalogue retenu par la variante : c'est lui qui porte les prix par
  /// etat, donc le calcul automatique de la plus-value. Vide = ligne chiffree a la main.
  catalogItemId  Int?          @map("catalog_item_id")
  /// Etat retenu dans la variante. Permet de passer un ouvrage de moyen a mauvais
  /// sans changer d'article : le prix suit l'etat, comme dans le diagnostic.
  state          ElementState?
  cfcCode        String        @map("cfc_code") @db.VarChar(10)
  label          String        @db.VarChar(255)
  unit           String?       @db.VarChar(50)
  area           Float?
  /// Montant HT. Calcule depuis le catalogue quand `costManual` est faux.
  amount         Decimal       @default(0) @db.Decimal(12, 2)
  /// true = montant force a la main : il ne suit plus le catalogue.
  costManual     Boolean       @default(false) @map("cost_manual")
  note           String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  variant  ProjectVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// L'ouvrage remplace peut disparaitre du diagnostic : la ligne survit, orpheline,
  /// et redevient un simple ajout plutot que de faire tomber la variante.
  replaces DiagnosticItem? @relation(fields: [replacesItemId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([replacesItemId])
  @@map("variant_lines")
}

// ============================================================================
// Base CFC v3 : la nomenclature suisse, les articles et leur ordre de visite.
//
// Ces tables vivent a cote de `catalog_items`, qu'elles remplaceront. Les deux
// cohabitent le temps que les diagnostics existants soient repris : un releve
// porte desormais `article_id` et `etape_numero`, et garde `catalog_item_id`
// tant que son ancien article n'a pas de repreneur.
// ============================================================================

/// Unites de prix. Liste fermee : une unite inventee rend un devis incomparable.
enum Unite {
  m2
  ml
  pce
  forfait
}

/// Les six colonnes d'etat du classeur. Amelioration et normes sont des
/// enveloppes a part, chiffrees hors du total principal.
enum EtatArticle {
  tres_bon
  bon
  moyen
  mauvais
  amelioration
  normes
}

/// D'ou vient la quantite d'un ouvrage. Les regles nommees sont celles que le
/// classeur ecrit en toutes lettres et qui ne se ramenent pas a un coefficient.
enum BaseQuantite {
  surface_plancher
  surface_batie
  surface_terrain
  surface_facade
  surface_fenetres
  facade_moins_fenetres
  nombre_logements
  nombre_pieces_eau
  nombre_etages
  nombre_cages
  nombre_portes_entree
  forfait
  saisie_manuelle
  regle_stores
  regle_eaux_pluviales
  regle_sprinklers
}

/// Ce qui fait apparaitre un poste automatique au devis.
enum DeclencheurPoste {
  toujours
  echafaudage_facade
  communs_mauvais
}

/// Comment se calcule la quantite d'un poste automatique.
enum RegleQuantitePoste {
  surface_echafaudee
  par_cage_escalier
  surface_plancher
  forfait
}

/// Nomenclature SN 506 500, quatre niveaux. Le code est du texte : « 221.0 »
/// et « 221 » sont deux codes differents, et un nombre perdrait le zero final.
model CfcNomenclature {
  code       String  @id @db.VarChar(12)
  libelle    String  @db.VarChar(255)
  niveau     Int     @db.UnsignedTinyInt
  parentCode String? @map("parent_code") @db.VarChar(12)

  parent   CfcNomenclature?  @relation("NomenclatureParent", fields: [parentCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  enfants  CfcNomenclature[] @relation("NomenclatureParent")
  articles Article[]

  @@index([parentCode], map: "idx_cfcn_parent")
  @@index([niveau], map: "idx_cfcn_niveau")
  @@map("cfc_nomenclature")
}

/// Un ouvrage du catalogue. L'identifiant vient du classeur (A005, N001) et
/// sert de cle a toutes les references : il ne change jamais.
model Article {
  id                 String       @id @db.VarChar(8)
  cfcCode            String       @map("cfc_code") @db.VarChar(12)
  nom                String       @db.VarChar(255)
  /// Chapitre du rapport client.
  domaineRapport     String       @map("domaine_rapport") @db.VarChar(80)
  /// Les articles d'un meme groupe se partagent une quantite : une facade peut
  /// etre a moitie crepie et a moitie ventilee. null = ouvrage non alternatif.
  groupeAlternatives String?      @map("groupe_alternatives") @db.VarChar(80)
  echafaudage        Boolean      @default(false)
  uniteEntretien     Unite        @map("unite_entretien")
  uniteRemplacement  Unite        @map("unite_remplacement")
  baseQuantite       BaseQuantite @map("base_quantite")
  /// Ce que le classeur met entre parentheses : « perimetre », « par ascenseur ».
  /// Affiche au diagnostiqueur, jamais calcule.
  indicationQuantite String?      @map("indication_quantite") @db.VarChar(160)
  coefficient        Float        @default(1)
  /// Consigne interne. N'est jamais imprimee dans le rapport client.
  noteDiagnostiqueur String?      @map("note_diagnostiqueur") @db.Text
  /// Article qui porte l'amelioration de celui-ci (A068 chauffage electrique
  /// vers A064 pompe a chaleur).
  articleLieId       String?      @map("article_lie_id") @db.VarChar(8)
  /// false = retire du catalogue. Un article utilise par un releve n'est
  /// jamais supprime, il est desactive.
  actif              Boolean      @default(true)
  /// Trace de la ligne du classeur d'origine, pour les reprises ulterieures.
  ligneOrigine       String?      @map("ligne_origine") @db.VarChar(16)
  creeLe             DateTime     @default(now()) @map("cree_le")
  modifieLe          DateTime     @updatedAt @map("modifie_le")

  nomenclature CfcNomenclature     @relation(fields: [cfcCode], references: [code], onUpdate: Cascade)
  articleLie   Article?            @relation("ArticleLie", fields: [articleLieId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lesLiens     Article[]           @relation("ArticleLie")
  etats        ArticleEtat[]
  etapes       ArticleEtape[]
  historique   ArticleHistorique[]
  releves      DiagnosticItem[]

  @@index([cfcCode], map: "idx_art_cfc")
  @@index([groupeAlternatives], map: "idx_art_groupe")
  @@index([actif], map: "idx_art_actif")
  @@map("articles")
}

/// Un etat d'un article : son texte de travaux, son prix, son unite.
/// L'absence de ligne vaut « aucun travail chiffre pour cet etat ».
model ArticleEtat {
  articleId       String      @map("article_id") @db.VarChar(8)
  etat            EtatArticle
  /// Texte imprime dans le rapport. « Neant » = aucun travail.
  travaux         String?     @db.Text
  /// CHF HT par unite. Pour l'etat moyen, c'est la part fixe du prix.
  prix            Decimal?    @db.Decimal(12, 2)
  /// Etat moyen seulement : part du prix Mauvais qui s'ajoute au prix fixe.
  /// Reglable par le diagnostiqueur a la saisie.
  partPrixMauvais Float?      @map("part_prix_mauvais")
  unite           Unite

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([articleId, etat])
  @@map("article_etats")
}

/// Les sept etapes du tour du batiment, dans l'ordre de la visite.
model EtapeVisite {
  numero Int    @id @db.UnsignedTinyInt
  nom    String @db.VarChar(80)
  /// Exterieur, Communs, Logements, Batiment entier.
  zone   String @db.VarChar(40)

  articles ArticleEtape[]
  releves  DiagnosticItem[]

  @@map("etapes_visite")
}

/// Un article peut se relever dans plusieurs etapes : la peinture des murs se
/// voit dans la cage d'escalier et dans les appartements. Chaque couple est un
/// releve distinct, avec son etat, ses photos et sa quantite.
model ArticleEtape {
  articleId      String @map("article_id") @db.VarChar(8)
  etapeNumero    Int    @map("etape_numero") @db.UnsignedTinyInt
  ordreDansEtape Int    @map("ordre_dans_etape") @db.UnsignedSmallInt

  article Article     @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  etape   EtapeVisite @relation(fields: [etapeNumero], references: [numero], onDelete: Cascade, onUpdate: Cascade)

  @@id([articleId, etapeNumero])
  @@index([etapeNumero, ordreDansEtape], map: "idx_ae_ordre")
  @@map("article_etapes")
}

/// Postes ajoutes au devis sans etre releves : echafaudages, nettoyage,
/// protection des ouvrages. Les prix sont lus ici, jamais ecrits en dur.
model PosteAutomatique {
  cfcCode       String             @id @map("cfc_code") @db.VarChar(12)
  libelle       String             @db.VarChar(255)
  declencheur   DeclencheurPoste
  unite         Unite
  prix          Decimal            @db.Decimal(12, 2)
  regleQuantite RegleQuantitePoste @map("regle_quantite")
  remarque      String?            @db.Text

  @@map("postes_automatiques")
}

/// Toute modification d'un article, pour que la fiche puisse la montrer.
model ArticleHistorique {
  id             String   @id @default(cuid())
  articleId      String   @map("article_id") @db.VarChar(8)
  champ          String   @db.VarChar(60)
  ancienneValeur String?  @map("ancienne_valeur") @db.Text
  nouvelleValeur String?  @map("nouvelle_valeur") @db.Text
  /// null = ecrit par un import, pas par une personne.
  auteurId       String?  @map("auteur_id")
  date           DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([articleId, date], map: "idx_ah_article")
  @@map("article_historique")
}

/// Une notification de l'application : ce que la cloche montre, ce que le push
/// envoie et ce que l'email reprend. Une seule ligne par sujet grace a `cle`.
model Notification {
  id     String  @id @default(cuid())
  userId String  @map("user_id")
  /// diagnostic_cree, priorite_urgente, rappel_visite, resume_hebdo.
  type   String  @db.VarChar(40)
  titre  String  @db.VarChar(160)
  texte  String? @db.Text
  /// Ou mene la notification quand on la touche.
  url    String? @db.VarChar(255)
  /// Dedoublonnage : « priorite-<diagnostic>-<jour> ». null = pas de regroupement.
  cle    String? @db.VarChar(120)

  lueLe  DateTime? @map("lue_le")
  creeLe DateTime  @default(now()) @map("cree_le")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cle], map: "uniq_notif_cle")
  @@index([userId, creeLe], map: "idx_notif_user")
  @@map("notifications")
}
